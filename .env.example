# Credentials for the CLI tools only — wrangler deploys and remote D1 migrations.
# These are NOT application secrets and must never be read by app code.
#
#   cp .env.example .env
#
# Only needed for `pnpm deploy:*` and `pnpm db:migrate:staging|production`.
# `pnpm dev`, `pnpm preview` and the tests all run against local D1 and need none of it.
# CI supplies both from GitHub repository secrets instead (see .github/workflows/cicd.yml).

# Cloudflare dashboard -> My Profile -> API Tokens -> "Edit Cloudflare Workers"
# template, plus D1 edit permission.
CLOUDFLARE_API_TOKEN=""

# Cloudflare dashboard -> Workers & Pages -> Account ID
CLOUDFLARE_ACCOUNT_ID=""

# Keep application secrets OUT of this file — put them in .dev.vars instead.
# Wrangler merges .env into the Worker's env for local development, so anything
# here would show up on `platform.env` and in `$env/dynamic/private`. Creating a
# .dev.vars file is what stops that: when .dev.vars exists, .env is excluded from
# the Worker env. See .dev.vars.example.
