{
	"name": "quiz-game",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "wrangler types && svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright install chromium && playwright test",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:seed:local": "wrangler d1 execute DB --local --file=./seeds/dev.sql",
		"db:setup:local": "pnpm run db:migrate:local && pnpm run db:seed:local",
		"db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
		"db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
		"db:studio": "drizzle-kit studio",
		"deploy:staging": "wrangler deploy --env staging",
		"deploy:production": "wrangler deploy --env production"
	},
	"dependencies": {
		"@flaticon/flaticon-uicons": "^3.3.1",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	}
}
